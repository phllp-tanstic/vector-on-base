{
  "name": "vector-on-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Intent execution layer for Coinbase Tokenized Stocks on Base.",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"packages/**/*.test.ts\"",
    "verify:authorization": "node services/api/verify-authorization.ts",
    "verify:base": "node packages/integrations/scripts/verify-base.ts",
    "verify:portfolio": "node services/api/verify-portfolio.ts",
    "verify:risk": "node services/api/verify-risk.ts",
    "verify:zerox": "node --env-file-if-exists=.env services/api/verify-zerox-quote.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "@types/node": "^26.4.1",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
