# Server-side only. Create the key in GroqCloud and never expose it through NEXT_PUBLIC_*.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Browser-safe Coinbase CDP project identifier.
NEXT_PUBLIC_CDP_PROJECT_ID=

# Optional browser-safe Base Sepolia demo faucet address.
NEXT_PUBLIC_VECTOR_TEST_DEMO_FAUCET_ADDRESS=
