# Vector environment template
#
# Never commit real secrets.

# Optional. Defaults to the standard public Base Mainnet RPC.
BASE_RPC_URL=https://mainnet.base.org

# Server-side only. Obtain from the official 0x Dashboard.
ZEROX_API_KEY=

# Required only by the non-submitting 0x firm-quote verification command.
VECTOR_VERIFY_TAKER=

# Optional raw USDC base units. Defaults to 1000000 (1 USDC); no transaction is submitted.
VECTOR_VERIFY_SELL_USDC=

# Required for production authorization-plan creation after VectorExecutor is deployed.
# Never use a fixture or guessed address here.
VECTOR_EXECUTOR_ADDRESS=

# Browser-safe public CDP project identifier. This is embedded in the web bundle.
# Register http://localhost:3000 as an allowed origin in the CDP Portal for local use.
NEXT_PUBLIC_CDP_PROJECT_ID=

# Base Sepolia deployment configuration. RPC URLs may contain provider credentials, so keep this
# value out of NEXT_PUBLIC_* variables and browser code.
BASE_SEPOLIA_RPC_URL=

# Public addresses, kept distinct: deployed executor contract and its owner/admin.
VECTOR_EXECUTOR_ADDRESS_SEPOLIA=
VECTOR_OWNER_ADDRESS=

# Never add CDP API secrets, Wallet Secrets, deployer private keys, or backend signing credentials
# to NEXT_PUBLIC_* variables. Use a Foundry keystore for deployment; no private-key placeholder is
# intentionally provided here.
